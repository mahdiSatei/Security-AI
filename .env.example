# Copy to .env and adjust as needed: cp .env.example .env
# .env is gitignored. Real environment variables override values in the file.

# --- Data locations (used once src/core/config.py lands from refactor/modular-src) ---
DATA_DIR=data
RAW_ALERTS_PATH=security_alerts.json
STANDARDIZED_ALERTS_PATH=standardized_alerts.json
MITRE_STIX_FILE=enterprise-attack.json
VALID_TECHNIQUES_PATH=valid_techniques.json
CHROMA_DIR=chroma_db

# --- MITRE source ---
MITRE_STIX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json

# --- Embeddings & collections ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
ALERTS_COLLECTION=security_alerts
TECHNIQUES_COLLECTION=mitre_techniques

# --- Retrieval thresholds ---
ALERT_MIN_SIMILARITY=0.30
MITRE_TOP_K=10
MITRE_MIN_SIMILARITY=0.20

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible endpoint). Loaded by src/llm_client.py.
# Keep the real key in .env only, never in code, notebook cells or git.
# ---------------------------------------------------------------------------
# OpenAI:     https://api.openai.com/v1
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_TOKENS=800
LLM_JSON_MODE=true
